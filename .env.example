# SIQE Studio settings. Copy to .env (`make env` does this and generates a password).
# Every SIQE_* variable maps to a field in backend/src/siqe/core/config.py.

# --- Required -----------------------------------------------------------------
# Password for the bundled PostgreSQL. Only reachable inside the Docker network.
POSTGRES_PASSWORD=change-me

# --- Network ------------------------------------------------------------------
# Where the web app listens. 127.0.0.1 keeps it on this machine; use 0.0.0.0 to
# expose it on your network (there is no login in single-user mode).
SIQE_BIND=127.0.0.1
SIQE_PORT=8080

# --- Version and images -------------------------------------------------------
# "latest" follows new releases on `docker compose pull`. Pin a version (e.g. 0.2.0)
# to stay put. Images are published to GitHub Container Registry on each release.
SIQE_VERSION=latest
SIQE_REGISTRY=ghcr.io/amerzuher

# --- Updates (Update Center in the top bar) ----------------------------------------
SIQE_UPDATE_REPO=AmerZuher/Super-Image-Quality-Enhancer
SIQE_UPDATE_INCLUDE_PRERELEASES=false
# Optional token: raises GitHub's rate limit and allows private repositories.
SIQE_GITHUB_TOKEN=

# --- Resource limits ------------------------------------------------------------
# Largest input image accepted, in megapixels (decompression-bomb guard).
SIQE_MAX_INPUT_MEGAPIXELS=250
# Largest single upload, in MB. Uploads stream to disk, so this only guards the data volume.
SIQE_MAX_UPLOAD_MB=2048
# Largest AI result, in megapixels. 8K upscaled ×4 is 531 MP; the output is assembled on disk.
SIQE_MAX_OUTPUT_MEGAPIXELS=1000
# VRAM kept free for the driver and fragmentation (MB). 1536 suits 8-24 GB cards.
SIQE_GPU_VRAM_RESERVE_MB=1536
# Share of the data disk kept free: uploads and exports pause below it (0.05 is 5%).
SIQE_MIN_FREE_DISK_RATIO=0.05
# Container memory caps. Raise the GPU worker's for very large batches or training. The API holds
# the search model's text half (about 250 MB) once CLIP search is installed.
SIQE_API_MEMORY=1536m
SIQE_CPU_WORKER_MEMORY=4g
SIQE_GPU_WORKER_MEMORY=12g

# --- Library import folder ------------------------------------------------------------
# Images dropped into this folder (and its subfolders) are added to the Library. It is mounted
# read-only: files are copied in and never moved or deleted. Relative paths are from this file.
SIQE_IMPORT_PATH=./import
# How often the folder is checked, in seconds. 0 turns automatic checks off ("Check now" still works).
SIQE_IMPORT_SCAN_SECONDS=60
# A file is imported only once it has been unchanged this long, so half-copied files wait.
SIQE_IMPORT_SETTLE_SECONDS=15

# --- Flows ------------------------------------------------------------------------------
# Where flows export files. Each run gets its own folder: <flow name>/<date time>/.
# If the containers can't write here, exports go to the data volume and stay downloadable.
SIQE_OUTPUT_PATH=./output
# How many images a run works on at once. AI blocks still take turns on the GPU.
SIQE_FLOW_CONCURRENCY=4

# --- Access ---------------------------------------------------------------------------
# off:  anyone who can reach the app can use it (fine on your own computer; SIQE_BIND keeps it local).
# keys: the web app and scripts need an API key. Make the first one with
#       `docker compose exec api siqe keys create "my laptop"`, then sign in with it.
SIQE_API_AUTH=off

# --- Logging ----------------------------------------------------------------------
SIQE_LOG_LEVEL=INFO
