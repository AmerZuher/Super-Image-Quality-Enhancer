{
  "openapi": "3.1.0",
  "info": {
    "title": "SIQE Studio API",
    "description": "Enhance, edit, organise and automate images, and train the models that do it.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "The API process is running",
        "operationId": "live_api_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Database and job engine are reachable",
        "operationId": "ready_api_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/system": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Version, services, workers and hardware",
        "operationId": "system_status_api_system_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Recent jobs, newest first",
        "operationId": "recent_jobs_api_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobOut"
                  },
                  "title": "Response Recent Jobs Api Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "One job",
        "operationId": "one_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/self-test": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Run the system self-test (CPU and GPU workers)",
        "operationId": "start_self_test_api_jobs_self_test_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Ask a running job to stop",
        "operationId": "cancel_job_api_jobs__job_id__cancel_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/updates": {
      "get": {
        "tags": [
          "updates"
        ],
        "summary": "Running version, newer releases and their notes",
        "operationId": "update_status_api_updates_get",
        "parameters": [
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Ask GitHub now instead of using the cached list.",
              "default": false,
              "title": "Refresh"
            },
            "description": "Ask GitHub now instead of using the cached list."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateStatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthOut"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "State"
          },
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "state",
          "progress",
          "message",
          "params",
          "result",
          "error",
          "created_at",
          "started_at",
          "finished_at"
        ],
        "title": "JobOut"
      },
      "ReleaseOut": {
        "properties": {
          "tag": {
            "type": "string",
            "title": "Tag"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "description": "Release notes in GitHub-flavoured Markdown."
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "prerelease": {
            "type": "boolean",
            "title": "Prerelease"
          }
        },
        "type": "object",
        "required": [
          "tag",
          "version",
          "name",
          "notes",
          "url",
          "published_at",
          "prerelease"
        ],
        "title": "ReleaseOut"
      },
      "ServicesOut": {
        "properties": {
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "temporal": {
            "type": "boolean",
            "title": "Temporal"
          },
          "events": {
            "type": "boolean",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "database",
          "temporal",
          "events"
        ],
        "title": "ServicesOut"
      },
      "SystemOut": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "services": {
            "$ref": "#/components/schemas/ServicesOut"
          },
          "api": {
            "additionalProperties": true,
            "type": "object",
            "title": "Api"
          },
          "workers": {
            "items": {
              "$ref": "#/components/schemas/WorkerOut"
            },
            "type": "array",
            "title": "Workers"
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment",
          "services",
          "api",
          "workers"
        ],
        "title": "SystemOut"
      },
      "UpdateStatusOut": {
        "properties": {
          "current_version": {
            "type": "string",
            "title": "Current Version"
          },
          "latest_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Version"
          },
          "update_available": {
            "type": "boolean",
            "title": "Update Available"
          },
          "newer": {
            "items": {
              "$ref": "#/components/schemas/ReleaseOut"
            },
            "type": "array",
            "title": "Newer",
            "description": "Releases newer than the running version, newest first."
          },
          "current": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReleaseOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Release notes for the running version, if published."
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "repo_url": {
            "type": "string",
            "title": "Repo Url"
          },
          "releases_url": {
            "type": "string",
            "title": "Releases Url"
          }
        },
        "type": "object",
        "required": [
          "current_version",
          "latest_version",
          "update_available",
          "newer",
          "current",
          "checked_at",
          "error",
          "repo_url",
          "releases_url"
        ],
        "title": "UpdateStatusOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkerOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cpu",
              "gpu"
            ],
            "title": "Kind"
          },
          "hostname": {
            "type": "string",
            "title": "Hostname"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "online": {
            "type": "boolean",
            "title": "Online"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "info": {
            "additionalProperties": true,
            "type": "object",
            "title": "Info"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "hostname",
          "version",
          "online",
          "last_seen",
          "started_at",
          "info"
        ],
        "title": "WorkerOut"
      }
    }
  }
}
